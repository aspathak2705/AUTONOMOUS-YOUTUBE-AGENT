# Autonomous YouTube Agent - Environment Variables (Backend)
# Copy this file to .env and fill in required values.
# NEVER commit .env to source control!

# ==============================================================================
# 1. Application Settings
# ==============================================================================
APP_NAME=autonomous-youtube-agent
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# ==============================================================================
# 2. Database Settings (Supabase-hosted PostgreSQL)
# ==============================================================================
# Example Supabase Direct (requires IPv6):
# DATABASE_URL=postgresql+psycopg://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres
# Example Supabase Session Pooler (IPv4 compatible, recommended for local/IPv4 clouds):
# DATABASE_URL=postgresql+psycopg://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_SSL_MODE=require
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# ==============================================================================
# 3. LLM Gateway (OpenRouter - Zero Paid API Budget)
# ==============================================================================
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model identifiers (must end with :free or be openrouter/free):
# Recommended: openrouter/free (auto-router) or meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Autonomous YouTube Agent

# ==============================================================================
# 4. YouTube Data API v3 & Google OAuth 2.0
# ==============================================================================
# Configure at Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback
# 32-byte URL-safe base64 key for AES-GCM / Fernet token encryption at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ==============================================================================
# 5. Scheduling & Workflow Defaults
# ==============================================================================
DEFAULT_TIMEZONE=Asia/Kolkata
MORNING_WORKFLOW_TIME=07:00
LONG_FORM_PUBLISH_TIME=18:00
SHORTS_PUBLISH_TIME=12:00
REMINDER_LEAD_HOURS=2

# ==============================================================================
# 6. Media Storage Configuration
# ==============================================================================
MEDIA_TEMP_DIR=./temp_media
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,mov,mkv
